{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Evidence Loom",
  "version": "0.1.0-beta.9",
  "identifier": "io.github.simonguo.evidenceloom",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "cd ../frontend && npm run build:tauri",
    "devUrl": "http://localhost:31741",
    "frontendDist": "../frontend/out"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Evidence Loom",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        },
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:31741 ws://localhost:31741"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/evidenceloom-runner"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  }
}
