{
  "name": "evidenceloom-frontend",
  "version": "0.1.0-beta.10",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev -p 31741 -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:tauri": "node ../scripts/build_desktop_frontend.mjs",
    "tauri": "cd .. && npm --prefix frontend exec -- tauri",
    "tauri:dev": "cd .. && scripts/ensure_sidecar_placeholder.sh && npm --prefix frontend exec -- tauri dev",
    "tauri:build": "cd .. && npm --prefix frontend exec -- tauri build"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.3",
    "@dicebear/core": "^9.4.3",
    "@tauri-apps/api": "^2.12.1",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.27",
    "jsdom": "29.1.1",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp",
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "7.1.6"
  }
}
