{
  "name": "evidenceloom-frontend",
  "version": "0.1.0-beta.1",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev -p 31741",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:tauri": "cross-env TAURI=1 next build",
    "tauri": "cd .. && npm --prefix frontend exec -- tauri",
    "tauri:dev": "cd .. && npm --prefix frontend exec -- tauri dev",
    "tauri:build": "cd .. && npm --prefix frontend exec -- tauri build"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@tailwindcss/typography": "^0.5.16",
    "@tauri-apps/api": "^2.11.1",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.21",
    "jsdom": "29.1.1",
    "postcss": "8.5.21",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
